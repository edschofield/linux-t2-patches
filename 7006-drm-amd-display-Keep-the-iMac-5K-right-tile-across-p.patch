From f75a2b416ee980fe3256a5c36ab7e258c000bf01 Mon Sep 17 00:00:00 2001
From: Ed Schofield <ed@aicharmers.com>
Date: Wed, 21 Oct 2026 13:03:46 +1100
Subject: [PATCH] drm/amd/display: Keep the iMac 5K right tile across
 power-downs

The iMac 5K panel is driven as two tiles: the left by eDP on link 0, the
right by DP on link 1. The right tile's receiver, HPD and AUX respond
only while the left tile's receiver is powered and its DPCD register
0x4F1 is set. Its HPD line therefore follows the left tile's power state,
not a cable, and DC treats every power-down of the left tile as an unplug
of the right:

- DPMS blank publishes DP-1 as disconnected, and the compositor re-lays
  out the panel as one 2560x2880 monitor, then again on wake.
- S3 resume detects DP-1 before its HPD rises. The rise often comes
  before HPD interrupts are enabled again, so it is missed.
- S3 resume in a scaled mode emulates DP-1, which reads its EDID while
  0x4F1 is clear and leaves a 640x480 DP-1 with no native mode.
- Resume with the panel already blanked publishes DP-1 as disconnected.

The right tile is part of the internal panel and cannot be unplugged.
Detect it once and keep its sink, as DC already does for eDP. Once its
EDID includes the extension block with the tile data, link_detect()
returns false for link 1 without touching the link, so HPD edges no
longer republish it. Resume then republishes the kept sink, so its two
special cases for link 1 are no longer needed.

Forcing the connector off through sysfs, or on while the panel is dark,
clears its published EDID and tile property. In the base, the next
detection republishes them; with the sink kept, none does. Restore them
from the kept sink when the connector's modes are next probed, without
AUX traffic.

Readiness then matters only when the right tile is enabled. Before
training it, wait up to 150 ms for its HPD and a successful DPCD read.
If the receiver is still not ready, warn and train as before.

A failed EDID read leaves a sink without the extension block, which is
not kept, so the next detection reads it again. Writing 0 to the
connector's debugfs trigger_hotplug still releases the sink.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 11 +---------
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 14 +++++++++++++
 drivers/gpu/drm/amd/display/dc/dc.h           | 13 ++++++++++++
 .../drm/amd/display/dc/link/link_detection.c  |  4 ++++
 .../gpu/drm/amd/display/dc/link/link_dpms.c   | 20 +++++++++++++++++++
 5 files changed, 52 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 7161f8a95..0fd417ebb 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -2019,20 +2019,11 @@ static int dm_resume(struct amdgpu_ip_block *ip_block)
 		if (!dc_link_detect_connection_type(aconnector->dc_link, &new_connection_type))
 			drm_err(adev_to_drm(adev), "KMS: Failed to detect connector\n");
 
-		if ((aconnector->base.force && new_connection_type == dc_connection_none)
-				|| (dm->dc->config.imac5K_support &&
-					!dm->dc->config.imac5K_using_5K &&
-					aconnector->dc_link->link_index == 1)) {
+		if (aconnector->base.force && new_connection_type == dc_connection_none) {
 			amdgpu_dm_emulated_link_detect(aconnector->dc_link);
 		} else {
 			guard(mutex)(&dm->dc_lock);
 			dc_exit_ips_for_hw_access(dm->dc);
-			if (dm->dc->config.imac5K_using_5K &&
-					aconnector->dc_link->link_index == 1) {
-				const u8 value = 1;
-
-				core_link_write_dpcd(dm->dc->links[0], 0x4F1, &value, 1);
-			}
 			ret = dc_link_detect(aconnector->dc_link, DETECT_REASON_RESUMEFROMS3S4);
 			if (ret) {
 				/* w/a delay for certain panels */
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 0b6d44890..6e1b81078 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3125,9 +3125,23 @@ static int amdgpu_dm_connector_get_modes(struct drm_connector *connector)
 	const struct drm_edid *drm_edid = amdgpu_dm_connector->drm_edid;
 	struct dc_link_settings *verified_link_cap = &dc_link->verified_link_cap;
 	const struct dc *dc = dc_link->dc;
+	struct dc_sink *sink = amdgpu_dm_connector->dc_sink;
 
 	encoder = amdgpu_dm_connector_to_encoder(connector);
 
+	/*
+	 * iMac 5K: forcing the right tile's connector off, or on while the
+	 * panel is dark, clears its published EDID. No detection publishes a
+	 * kept sink again, so restore the EDID from the sink.
+	 */
+	if (sink && dc_sink_is_kept_imac5k_tile(sink) && !connector->edid_blob_ptr) {
+		const struct drm_edid *kept = drm_edid_alloc(sink->dc_edid.raw_edid,
+							     sink->dc_edid.length);
+
+		drm_edid_connector_update(connector, kept);
+		drm_edid_free(kept);
+	}
+
 	if (!drm_edid) {
 		amdgpu_dm_connector->num_modes =
 				drm_add_modes_noedid(connector, 640, 480);
diff --git a/drivers/gpu/drm/amd/display/dc/dc.h b/drivers/gpu/drm/amd/display/dc/dc.h
index 022707594..f2ed31efa 100644
--- a/drivers/gpu/drm/amd/display/dc/dc.h
+++ b/drivers/gpu/drm/amd/display/dc/dc.h
@@ -3198,6 +3198,19 @@ struct dc_sink_init_data {
 
 struct dc_sink *dc_sink_create(const struct dc_sink_init_data *init_params);
 
+/*
+ * iMac 5K: link 1 drives the internal panel's right tile, whose HPD drops
+ * whenever the left tile's eDP powers down. As for eDP, keep its sink once
+ * its EDID includes the extension block with the tile data.
+ */
+static inline bool dc_sink_is_kept_imac5k_tile(const struct dc_sink *sink)
+{
+	return sink->link->dc->config.imac5K_support &&
+	       sink->link->link_index == 1 &&
+	       sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT &&
+	       sink->dc_edid.length > DC_EDID_BLOCK_SIZE;
+}
+
 /* Newer interfaces  */
 struct dc_cursor {
 	struct dc_plane_address address;
diff --git a/drivers/gpu/drm/amd/display/dc/link/link_detection.c b/drivers/gpu/drm/amd/display/dc/link/link_detection.c
index f254f2d9e..36c8f1eec 100644
--- a/drivers/gpu/drm/amd/display/dc/link/link_detection.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_detection.c
@@ -1633,6 +1633,10 @@ bool link_detect(struct dc_link *link, enum dc_detect_reason reason)
 	bool is_delegated_to_mst_top_mgr = false;
 	enum dc_connection_type pre_link_type = link->type;
 
+	/* iMac 5K: returning false stops the HPD handlers republishing it. */
+	if (link->local_sink && dc_sink_is_kept_imac5k_tile(link->local_sink))
+		return false;
+
 	is_local_sink_detect_success = detect_link_and_local_sink(link, reason);
 
 	if (is_local_sink_detect_success && link->local_sink) {
diff --git a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
index 25ec3d38a..8df36f035 100644
--- a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
@@ -2073,6 +2073,26 @@ static enum dc_status enable_link_dp(struct dc_state *state,
 			!link->dc->config.enable_dpia_pre_training)
 		do_fallback = true;
 
+	/*
+	 * iMac 5K: the right tile's receiver answers only after the left
+	 * tile's D0 write has re-armed 0x4F1.
+	 */
+	if (link->dc->config.imac5K_support && link->link_index == 1) {
+		DC_LOGGER_INIT(link->ctx->logger);
+		unsigned long long start = dm_get_timestamp(link->ctx);
+		uint8_t rev;
+
+		while (!link_get_hpd_state(link) ||
+		       core_link_read_dpcd(link, DP_DPCD_REV, &rev, 1) != DC_OK) {
+			if (dm_get_elapse_time_in_ns(link->ctx, dm_get_timestamp(link->ctx),
+						     start) > 150 * NSEC_PER_MSEC) {
+				DC_LOG_WARNING("iMac 5K: right tile not ready for training\n");
+				break;
+			}
+			fsleep(1000);
+		}
+	}
+
 	/*
 	 * Temporary w/a to get DP2.0 link rates to work with SST.
 	 * TODO DP2.0 - Workaround: Remove w/a if and when the issue is resolved.
-- 
