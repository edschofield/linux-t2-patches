diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c
new file mode 100644
index 0000000000000000000000000000000000000000..c3c7d31c790a9f0e375f1ada7cba283e034dbb36
--- /dev/null
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: MIT
+/* Bounded resume recovery for the mapped iMac SST companion. */
+#include <drm/drm_atomic.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_probe_helper.h>
+
+#include "amdgpu.h"
+#include "amdgpu_dm.h"
+#include "amdgpu_dm_connector.h"
+#include "amdgpu_dm_hdcp.h"
+#include "dc.h"
+#include "dc/dc_stream.h"
+#include "dc/dc_dmub_srv.h"
+
+static const unsigned int recovery_delays_ms[] = { 500, 1000, 2000 };
+
+static bool valid_sink(struct dc_link *link)
+{
+	struct dc_sink *sink = link->local_sink;
+	const struct drm_edid *edid;
+	bool valid;
+
+	if (link->type != dc_connection_single || !sink ||
+	    sink->sink_signal != SIGNAL_TYPE_DISPLAY_PORT ||
+	    !sink->dc_edid.length ||
+	    sink->dc_edid.length > sizeof(sink->dc_edid.raw_edid))
+		return false;
+
+	edid = drm_edid_alloc(sink->dc_edid.raw_edid, sink->dc_edid.length);
+	valid = edid && drm_edid_valid(edid);
+	drm_edid_free(edid);
+	return valid;
+}
+
+/* hpd_lock held, including across detect: never bless a retained failed sink. */
+void dm_imac5k_detected(struct amdgpu_dm_connector *aconnector, bool detected)
+{
+	struct dm_imac5k_recovery *r = &drm_to_adev(aconnector->base.dev)->dm.imac5k_recovery;
+
+	if (r->connector != aconnector)
+		return;
+	if (r->acquired)
+		dc_sink_release(r->acquired);
+	r->acquired = NULL;
+	if (detected && valid_sink(aconnector->dc_link)) {
+		r->acquired = aconnector->dc_link->local_sink;
+		dc_sink_retain(r->acquired);
+	}
+}
+
+/* Current DRM routing, with modeset locks held; never recover a saved route. */
+static struct dc_stream_state *active_stream(struct amdgpu_dm_connector *aconnector)
+{
+	struct drm_connector *connector = &aconnector->base;
+	struct drm_crtc *crtc = connector->state ? connector->state->crtc : NULL;
+
+	if (!crtc || !connector->encoder || connector->encoder->crtc != crtc ||
+	    !crtc->state || !crtc->state->active)
+		return NULL;
+	return to_dm_crtc_state(crtc->state)->stream;
+}
+
+/* Modeset locks held. The primary check must not detect or power on eDP. */
+static const char *cancel_reason(struct dm_imac5k_recovery *r)
+{
+	struct dc *dc = drm_to_adev(r->connector->base.dev)->dm.dc;
+
+	if (!r->primary || r->primary->dc_link != dc->imac5k_pair.primary ||
+	    r->connector->dc_link != dc->imac5k_pair.companion)
+		return "pair_missing";
+	if (!r->connector->base.state)
+		return "state_missing";
+	if (r->primary->base.force != DRM_FORCE_UNSPECIFIED ||
+	    r->connector->base.force != DRM_FORCE_UNSPECIFIED)
+		return "forced";
+	return active_stream(r->primary) ? NULL : "primary_inactive";
+}
+
+/* hpd_lock held. A published sink may have been acquired by ordinary HPD. */
+static bool published_sink(struct amdgpu_dm_connector *aconnector)
+{
+	return aconnector->dc_sink && aconnector->dc_sink == aconnector->dc_link->local_sink &&
+		valid_sink(aconnector->dc_link);
+}
+
+/* hpd_lock held. Preserve acquisition provenance through restore failures. */
+static int acquire_sink(struct dm_imac5k_recovery *r)
+{
+	struct amdgpu_dm_connector *aconnector = r->connector;
+	struct drm_device *dev = aconnector->base.dev;
+	struct amdgpu_device *adev = drm_to_adev(dev);
+	struct dc_link *link = aconnector->dc_link;
+	struct dc_sink *old_sink;
+	bool detected;
+
+	/* An acquired sink survives restore errors; do not detect it again. */
+	if (!r->acquired || r->acquired != link->local_sink ||
+	    r->acquired != aconnector->dc_sink || !valid_sink(link)) {
+		if (adev->dm.hdcp_workqueue) {
+			hdcp_reset_display(adev->dm.hdcp_workqueue, link->link_index);
+			if (aconnector->base.state)
+				to_dm_connector_state(aconnector->base.state)->update_hdcp = true;
+		}
+		aconnector->fake_enable = false;
+		aconnector->timing_changed = false;
+		scoped_guard(mutex, &adev->dm.dc_lock) {
+			dc_exit_ips_for_hw_access(adev->dm.dc);
+			detected = dc_link_detect(link, DETECT_REASON_HPD);
+		}
+		dm_imac5k_detected(aconnector, detected);
+		/* Also reconcile a removed local sink when detect returned false. */
+		if (!link->local_sink || r->acquired) {
+			if (detected)
+				amdgpu_dm_apply_delay_after_dpcd_poweroff(
+					adev, aconnector->dc_sink);
+			old_sink = aconnector->dc_sink;
+			if (old_sink)
+				dc_sink_retain(old_sink);
+			amdgpu_dm_update_connector_after_detect(aconnector);
+			r->notify_pending |= old_sink != aconnector->dc_sink;
+			if (old_sink)
+				dc_sink_release(old_sink);
+		}
+		if (!detected || !r->acquired)
+			return -ENOLINK;
+	}
+
+	return 0;
+}
+
+/*
+ * Under hpd_lock, with DRM route checks under the modeset locks:
+ * forced/missing pair or inactive primary -> cancel;
+ * published sink with no route, or already in the active stream -> skip work;
+ * stale active stream -> acquire and restore on its current route;
+ * no active companion route -> acquire, leaving routing to userspace.
+ * Worker publication needs one terminal event, even after late cancellation.
+ * Resume acquisition alone does not leave a pending worker notification.
+ */
+static void recovery_work(struct work_struct *work)
+{
+	struct dm_imac5k_recovery *r = container_of(to_delayed_work(work),
+						 struct dm_imac5k_recovery, work);
+	struct amdgpu_dm_connector *aconnector = r->connector;
+	struct drm_device *dev = aconnector->base.dev;
+	struct dc_stream_state *stream;
+	const char *reason;
+	bool attempted = false, restored = false, already_acquired = false;
+	bool acquired_only = false, terminal, notify;
+	int ret = -ECANCELED;
+
+	mutex_lock(&aconnector->hpd_lock);
+	drm_modeset_lock_all(dev);
+	reason = cancel_reason(r);
+	if (!reason) {
+		r->attempt++;
+		stream = active_stream(aconnector);
+		if (published_sink(aconnector)) {
+			restored = stream && stream->sink == aconnector->dc_sink;
+			/* Our acquisition still needs its terminal notification. */
+			already_acquired = !stream && !r->notify_pending;
+		}
+	}
+	drm_modeset_unlock_all(dev);
+	if (!reason) {
+		ret = 0;
+		if (!restored && !already_acquired) {
+			ret = acquire_sink(r);
+			/* Detection drops modeset locks; routes and force may have changed. */
+			drm_modeset_lock_all(dev);
+			reason = cancel_reason(r);
+			if (reason) {
+				ret = -ECANCELED;
+			} else if (!ret) {
+				stream = active_stream(aconnector);
+				acquired_only = !stream;
+				restored = stream && stream->sink == aconnector->dc_sink;
+				if (!acquired_only && !restored)
+					ret = dm_restore_drm_connector_state_result(
+						&aconnector->base, &attempted);
+			}
+			drm_modeset_unlock_all(dev);
+		}
+	}
+	terminal = reason || !ret || r->attempt == ARRAY_SIZE(recovery_delays_ms);
+	notify = terminal && (r->notify_pending ||
+		(!reason && !restored && !already_acquired));
+	if (terminal)
+		r->notify_pending = false;
+	if (!terminal)
+		schedule_delayed_work(&r->work, msecs_to_jiffies(recovery_delays_ms[r->attempt]));
+	if (terminal && ret && !reason)
+		drm_warn(dev, "iMac recovery: attempt=%u acquired=%d commit=%d ret=%d terminal=%d link_active=%d already_restored=%d acquired_only=%d already_acquired=%d cancel=%s\n",
+			 r->attempt, r->acquired != NULL, attempted, ret, terminal,
+			 aconnector->dc_link->link_status.link_active, restored,
+			 acquired_only, already_acquired, reason ?: "none");
+	else
+		drm_info(dev, "iMac recovery: attempt=%u acquired=%d commit=%d ret=%d terminal=%d link_active=%d already_restored=%d acquired_only=%d already_acquired=%d cancel=%s\n",
+			 r->attempt, r->acquired != NULL, attempted, ret, terminal,
+			 aconnector->dc_link->link_status.link_active, restored,
+			 acquired_only, already_acquired, reason ?: "none");
+	mutex_unlock(&aconnector->hpd_lock);
+	if (notify)
+		drm_kms_helper_connector_hotplug_event(&aconnector->base);
+}
+
+void dm_imac5k_init(struct amdgpu_display_manager *dm)
+{
+	INIT_DELAYED_WORK(&dm->imac5k_recovery.work, recovery_work);
+}
+
+void dm_imac5k_cancel(struct amdgpu_display_manager *dm)
+{
+	struct dm_imac5k_recovery *r = &dm->imac5k_recovery;
+	struct amdgpu_dm_connector *aconnector = r->connector;
+
+	/* No IRQ/commit producer: only resume can start another episode. */
+	cancel_delayed_work_sync(&r->work);
+	if (!aconnector)
+		return;
+	mutex_lock(&aconnector->hpd_lock);
+	if (r->acquired)
+		dc_sink_release(r->acquired);
+	r->acquired = NULL;
+	r->notify_pending = false;
+	r->connector = NULL;
+	mutex_unlock(&aconnector->hpd_lock);
+	drm_connector_put(&aconnector->base);
+	drm_connector_put(&r->primary->base);
+	r->primary = NULL;
+}
+
+void dm_imac5k_capture(struct amdgpu_display_manager *dm)
+{
+	struct dm_imac5k_recovery *r = &dm->imac5k_recovery;
+	struct drm_connector *connector;
+	struct drm_connector_state *state;
+	struct drm_crtc_state *crtc_state;
+	struct amdgpu_dm_connector *aconnector, *primary;
+	int i;
+
+	if (!dm->cached_state || !dm->dc->imac5k_pair.companion ||
+	    !dm->dc->imac5k_pair.primary)
+		return;
+	primary = dm->dc->imac5k_pair.primary->priv;
+	if (!primary || primary->dc_link != dm->dc->imac5k_pair.primary ||
+	    primary->base.force != DRM_FORCE_UNSPECIFIED || primary->mst_root)
+		return;
+	/* Require an active saved tile-mode primary; the companion may be inactive. */
+	state = drm_atomic_get_new_connector_state(dm->cached_state, &primary->base);
+	if (!state || !state->crtc)
+		return;
+	crtc_state = drm_atomic_get_new_crtc_state(dm->cached_state, state->crtc);
+	if (!crtc_state || !crtc_state->active ||
+	    crtc_state->mode.hdisplay != 2560 || crtc_state->mode.vdisplay != 2880)
+		return;
+
+	for_each_new_connector_in_state(dm->cached_state, connector, state, i) {
+		if (connector->connector_type != DRM_MODE_CONNECTOR_DisplayPort ||
+		    connector->force != DRM_FORCE_UNSPECIFIED)
+			continue;
+		aconnector = to_amdgpu_dm_connector(connector);
+		if (aconnector->dc_link != dm->dc->imac5k_pair.companion || aconnector->mst_root)
+			continue;
+		guard(mutex)(&aconnector->hpd_lock);
+		drm_connector_get(connector);
+		drm_connector_get(&primary->base);
+		r->connector = aconnector;
+		r->primary = primary;
+		r->attempt = 0;
+		r->notify_pending = false;
+		return;
+	}
+}
+
+void dm_imac5k_queue(struct amdgpu_display_manager *dm, int restore_error)
+{
+	struct dm_imac5k_recovery *r = &dm->imac5k_recovery;
+
+	if (!r->connector)
+		return;
+	if (!restore_error)
+		schedule_delayed_work(&r->work, msecs_to_jiffies(recovery_delays_ms[0]));
+}
