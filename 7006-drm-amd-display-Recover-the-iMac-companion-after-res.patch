+/* SPDX-License-Identifier: MIT */
+#ifndef AMDGPU_DM_IMAC5K_H
+#define AMDGPU_DM_IMAC5K_H
+
+#include <linux/workqueue.h>
+
+struct amdgpu_display_manager;
+struct amdgpu_dm_connector;
+struct dc_sink;
+
+/* Resume owns both connector references until synchronous cancellation. */
+struct dm_imac5k_recovery {
+	struct delayed_work work;
+	struct amdgpu_dm_connector *connector;
+	struct amdgpu_dm_connector *primary;
+	/* Remaining fields are serialized by the companion hpd_lock. */
+	struct dc_sink *acquired;
+	unsigned int attempt;
+	/* Worker publication awaiting a terminal hotplug event. */
+	bool notify_pending;
+};
+
+void dm_imac5k_init(struct amdgpu_display_manager *dm);
+void dm_imac5k_cancel(struct amdgpu_display_manager *dm);
+void dm_imac5k_capture(struct amdgpu_display_manager *dm);
+void dm_imac5k_detected(struct amdgpu_dm_connector *aconnector, bool detected);
+void dm_imac5k_queue(struct amdgpu_display_manager *dm, int restore_error);
+
+#endif
