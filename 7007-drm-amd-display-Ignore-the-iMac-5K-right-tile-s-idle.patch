From d5945720bdb9b70b8f4824e70b24cc88295bf1b2 Mon Sep 17 00:00:00 2001
From: Ed Schofield <ed@aicharmers.com>
Date: Wed, 21 Oct 2026 13:03:54 +1100
Subject: [PATCH] drm/amd/display: Ignore the iMac 5K right tile's idle lane
 status

After training, DC checks the lane status while the link sends the idle
pattern. With 0x4F1 set, the iMac's right tile always passed clock
recovery and channel equalisation, but this idle check reported lane
loss in 103 of 189 attempts. When all four attempts failed this way,
DC logged "enabling link 1 failed: 15", yet the lanes were aligned once
video flowed.

For the right tile only, ignore the lane bits read during idle, but
still treat a failed read as link loss so it gets the normal retries.
Clock recovery, equalisation and live link-loss handling are unchanged.
The existing skip_fallback_on_link_loss flag is not used because it
also relaxes the equalisation alignment check and changes live
link-loss handling.
---
 .../amd/display/dc/link/protocols/link_dp_training.c   | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c
index 04eedec8a..8cddc5b0b 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c
@@ -1530,8 +1530,16 @@ static enum link_training_result dp_transition_to_video_idle(
 		 */
 		if (link->connector_signal != SIGNAL_TYPE_EDP && status == LINK_TRAINING_SUCCESS) {
 			msleep(5);
-			if (!link->skip_fallback_on_link_loss)
+			if (link->dc->config.imac5K_support && link->link_index == 1) {
+				uint8_t lanes;
+
+				/* iMac 5K: the right tile reports lane loss until video flows. */
+				if (core_link_read_dpcd(link, DP_LANE0_1_STATUS,
+							&lanes, 1) != DC_OK)
+					status = LINK_TRAINING_LINK_LOSS;
+			} else if (!link->skip_fallback_on_link_loss) {
 				status = dp_check_link_loss_status(link, lt_settings);
+			}
 		}
 		return status;
 	}
