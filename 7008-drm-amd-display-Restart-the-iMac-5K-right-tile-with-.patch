From 8404bf6e8c29280d3248bad379f97d8b1c893f55 Mon Sep 17 00:00:00 2001
From: Ed Schofield <ed@aicharmers.com>
Date: Wed, 21 Oct 2026 13:04:20 +1100
Subject: [PATCH] drm/amd/display: Restart the iMac 5K right tile with the left

DC restarts a link without touching other streams when only that
stream's timing or output colour space changes. On the iMac 5K, a
"max bpc" or "Colorspace" change on the left tile's eDP alone, or
blanking and waking only the left tile's CRTC, therefore restarts the
left tile's link while the right tile's stream stays in place. The left
tile's D3 write clears 0x4F1 and the right tile loses its link. Since
the right tile's sink is kept, its HPD edges no longer lead to a
detection and restore commit, so nothing retrains it.

DC already uses link_state_valid == false to mean "apply this link
again although its stream is unchanged". When the left tile's pipe
will be (re)enabled, mark the right tile's link invalid before the
reset loop. The reset loop then tears the right tile down, and the
enable loop restarts it after the left tile. Move the search for the two
tiles' pipes above the reset to do this.
---
 .../amd/display/dc/hwss/dce110/dce110_hwseq.c | 49 ++++++++++++-------
 1 file changed, 31 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c b/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
index 8138cef66..3d19eac64 100644
--- a/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
+++ b/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
@@ -2666,6 +2666,37 @@ enum dc_status dce110_apply_ctx_to_hw(
 	if (dc->config.use_pipe_ctx_sync_logic)
 		reset_syncd_pipes_from_disabled_pipes(dc, context);
 
+	/* iMac 5K: the right tile (link 1) trains only once the left is up. */
+	for (i = 0; i < dc->res_pool->pipe_count; i++) {
+		struct pipe_ctx *pipe = &context->res_ctx.pipe_ctx[i];
+
+		enable_order[i] = i;
+		if (!dc->config.imac5K_support || !pipe->stream ||
+		    pipe->top_pipe || pipe->prev_odm_pipe)
+			continue;
+		if (pipe->stream->link->link_index == 0)
+			primary = i;
+		else if (pipe->stream->link->link_index == 1)
+			companion = i;
+	}
+	if (companion >= 0 && primary > companion) {
+		enable_order[companion] = primary;
+		enable_order[primary] = companion;
+	}
+
+	/*
+	 * iMac 5K: restarting the left tile's link powers down the right
+	 * tile's receiver, so restart an unchanged right tile with it.
+	 */
+	if (primary >= 0 && companion >= 0) {
+		struct pipe_ctx *old = &dc->current_state->res_ctx.pipe_ctx[primary];
+		struct dc_link *right = context->res_ctx.pipe_ctx[companion].stream->link;
+
+		if (!old->stream ||
+		    pipe_need_reprogram(old, &context->res_ctx.pipe_ctx[primary]))
+			right->link_state_valid = false;
+	}
+
 	/* Reset old context */
 	/* look up the targets that have been removed since last commit */
 	hws->funcs.reset_hw_ctx_wrap(dc, context);
@@ -2707,24 +2738,6 @@ enum dc_status dce110_apply_ctx_to_hw(
 		dc->hwseq->funcs.setup_hpo_hw_control(dc->hwseq, is_hpo_acquired);
 	}
 
-	/* iMac 5K: the right tile (link 1) trains only once the left is up. */
-	for (i = 0; i < dc->res_pool->pipe_count; i++) {
-		struct pipe_ctx *pipe = &context->res_ctx.pipe_ctx[i];
-
-		enable_order[i] = i;
-		if (!dc->config.imac5K_support || !pipe->stream ||
-		    pipe->top_pipe || pipe->prev_odm_pipe)
-			continue;
-		if (pipe->stream->link->link_index == 0)
-			primary = i;
-		else if (pipe->stream->link->link_index == 1)
-			companion = i;
-	}
-	if (companion >= 0 && primary > companion) {
-		enable_order[companion] = primary;
-		enable_order[primary] = companion;
-	}
-
 	for (n = 0; n < dc->res_pool->pipe_count; n++) {
 		struct pipe_ctx *pipe_ctx_old =
 			&dc->current_state->res_ctx.pipe_ctx[enable_order[n]];
