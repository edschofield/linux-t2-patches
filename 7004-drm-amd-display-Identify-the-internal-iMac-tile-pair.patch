--- /dev/null
+++ b/drivers/gpu/drm/amd/display/dc/link/link_imac5k.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+/* FILE POLICY AND INTENDED USAGE:
+ * The iMac internal 5K panel is driven as two tiles: the left through an eDP
+ * link (the primary) and the right through a DP link (the companion). The
+ * companion's receiver only answers while the primary's panel holds vendor
+ * DPCD register 0x4F1 set to 1, and every DP_SET_POWER=D3 write to the
+ * primary clears it.
+ *
+ * DM maps the supported pair in dc->imac5k_pair. Existing callers use
+ * dc_lock to serialize AUX access; check serialization at each new caller.
+ * Nothing here takes DM locks, detects connectors or emits hotplug events.
+ */
+
+#include "link_imac5k.h"
+#include "protocols/link_dpcd.h"
+
+#define DC_LOGGER \
+	link->ctx->logger
+
+/* Vendor DPCD register on the primary that enables the companion's link. */
+#define IMAC5K_DPCD_COMPANION_ENABLE	0x4F1
+#define IMAC5K_COMPANION_ENABLE_ON	0x01
+
+/**
+ * link_imac5k_arm() - make sure the companion's link is enabled
+ * @link: the primary link selected by an existing iMac quirk caller
+ *
+ * On the mapped primary, read the register and write only if it is not 1. A
+ * live companion then avoids redundant writes. A failed read is a failure,
+ * not a sign that the register is clear. Unmapped links keep the original
+ * blind write. Nothing is cached.
+ *
+ * Return: DC_OK if the register reads, or was written to, 1; otherwise the
+ * failed read's or write's status.
+ */
+enum dc_status link_imac5k_arm(struct dc_link *link)
+{
+	uint8_t value = IMAC5K_COMPANION_ENABLE_ON;
+	enum dc_status status;
+
+	if (!link_imac5k_is_primary(link))
+		return core_link_write_dpcd(link, IMAC5K_DPCD_COMPANION_ENABLE,
+					    &value, sizeof(value));
+
+	status = core_link_read_dpcd(link, IMAC5K_DPCD_COMPANION_ENABLE,
+				     &value, sizeof(value));
+	if (status != DC_OK) {
+		DC_LOG_DC("iMac 5K: reading 0x%x failed: %d\n",
+			  IMAC5K_DPCD_COMPANION_ENABLE, status);
+		return status;
+	}
+
+	if (value == IMAC5K_COMPANION_ENABLE_ON)
+		return DC_OK;
+
+	value = IMAC5K_COMPANION_ENABLE_ON;
+	status = core_link_write_dpcd(link, IMAC5K_DPCD_COMPANION_ENABLE,
+				      &value, sizeof(value));
+	DC_LOG_DC("iMac 5K: wrote 0x%x=0x%02x: %d\n",
+		  IMAC5K_DPCD_COMPANION_ENABLE, value, status);
+	return status;
+}
