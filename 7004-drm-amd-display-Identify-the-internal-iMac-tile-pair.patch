+/*
+ * Map the iMac internal 5K tile pair for DC. Only the iMac20,1 / Radeon Pro
+ * 5300 wiring is known: the sole eDP at link 0 and a physical, non-USB-C DP
+ * port at link 1. Anything else, including another iMac 5K board, stays
+ * unmapped and keeps the original handling.
+ */
+static void dm_imac5k_map_pair(struct amdgpu_device *adev)
+{
+	struct dc *dc = adev->dm.dc;
+	struct pci_dev *pdev = adev->pdev;
+	struct dc_link *primary, *companion;
+	unsigned int i, edp_count = 0;
+
+	if (!dc->config.imac5K_support)
+		return;
+
+	if (!dmi_match(DMI_PRODUCT_NAME, "iMac20,1") ||
+	    pdev->device != 0x7340 || pdev->subsystem_vendor != 0x106b ||
+	    pdev->subsystem_device != 0x0218 || dc->link_count < 2)
+		goto unmapped;
+
+	primary = dc->links[0];
+	companion = dc->links[1];
+	if (!primary || !companion ||
+	    primary->connector_signal != SIGNAL_TYPE_EDP ||
+	    companion->connector_signal != SIGNAL_TYPE_DISPLAY_PORT ||
+	    companion->ep_type != DISPLAY_ENDPOINT_PHY || !companion->link_enc ||
+	    companion->link_enc->features.flags.bits.DP_IS_USB_C)
+		goto unmapped;
+
+	for (i = 0; i < dc->link_count; i++)
+		if (dc->links[i] && dc->links[i]->connector_signal == SIGNAL_TYPE_EDP)
+			edp_count++;
+	if (edp_count != 1)
+		goto unmapped;
+
+	dc->imac5k_pair.primary = primary;
+	dc->imac5k_pair.companion = companion;
+	drm_info(adev_to_drm(adev), "iMac 5K: tile pair mapped: primary link %u, companion link %u\n",
+		 primary->link_index, companion->link_index);
+	return;
+
+unmapped:
+	drm_info(adev_to_drm(adev), "iMac 5K: no tile pair mapping for %04x:%04x %04x:%04x\n",
+		 pdev->vendor, pdev->device, pdev->subsystem_vendor,
+		 pdev->subsystem_device);
+}
