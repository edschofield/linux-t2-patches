From cf64603068120716c04bc7d0d9f02bb9dbf46c54 Mon Sep 17 00:00:00 2001
From: Ed Schofield <ed@aicharmers.com>
Date: Wed, 21 Oct 2026 05:44:31 +1100
Subject: [PATCH] drm/amd/display: Bound the iMac companion's wake fallback

The wake check's fallback runs ordinary detection, which is destructive
for DP: it drops the link's sink before reading the receiver. If that
read fails, nothing is published and the connector keeps a sink that the
link no longer has. The identity then never validates again, so later
blanks are not held and nothing retries. A DP detection without EDID
succeeds with an empty sink, and a restore whose training fails leaves an
inactive link; neither was checked again either. The check also decided
under dc_lock and detected under a later dc_lock, as does the HPD handler,
so a blank in between published a disconnect for a pair that had just
gone dark.

Recheck the pair inside the ordinary body's dc_lock section, immediately
before detection: a mapped companion of a dark pair with HPD low and a
valid published sink enters the hold instead. The handler's own entry
decision uses the same predicate.

After a fallback detection, apply the check's confirmation. A low HPD is
final. An eligible pair that is not confirmed keeps the hold and is
checked again a second later, up to three detections per hold. After the
last, publish the link's sink if the connector disagrees with it, so the
published state is coherent and the next wake's rise can acquire the
companion through the ordinary path.

Document the hold's four flag states and assert the locks the resume and
recheck helpers require.
---
 .../amd/display/amdgpu_dm/amdgpu_dm_imac5k.c  | 180 ++++++++++++++----
 .../amd/display/amdgpu_dm/amdgpu_dm_imac5k.h  |  18 +-
 .../drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c |   3 +
 3 files changed, 160 insertions(+), 41 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c
index 4823586be59bfd3345701c0240a298d993b43b40..39118543b5348afc3c396f6b563671c029b5488d 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.c
@@ -20,6 +20,7 @@
 static const unsigned int recovery_delays_ms[] = { 500, 1000, 2000 };
 
 #define IMAC5K_HOLD_CHECK_MS	1000
+#define IMAC5K_HOLD_DETECTIONS	3
 
 static bool valid_sink(struct dc_link *link)
 {
@@ -223,8 +224,8 @@ static struct dc_stream_state *pair_stream(struct dc *dc, struct dc_link *link)
 	return NULL;
 }
 
-/* hpd_lock held. An unforced SST pair whose companion published a real sink. */
-static bool companion_identity(struct amdgpu_dm_connector *aconnector)
+/* hpd_lock held. The mapped companion of an unforced SST pair. */
+static bool pair_eligible(struct amdgpu_dm_connector *aconnector)
 {
 	struct dc *dc = aconnector->dc_link->ctx->dc;
 	struct amdgpu_dm_connector *primary =
@@ -232,8 +233,13 @@ static bool companion_identity(struct amdgpu_dm_connector *aconnector)
 
 	return aconnector->dc_link == dc->imac5k_pair.companion && primary &&
 		aconnector->base.force == DRM_FORCE_UNSPECIFIED && !aconnector->mst_root &&
-		primary->base.force == DRM_FORCE_UNSPECIFIED && !primary->mst_root &&
-		published_sink(aconnector);
+		primary->base.force == DRM_FORCE_UNSPECIFIED && !primary->mst_root;
+}
+
+/* hpd_lock held. An unforced SST pair whose companion published a real sink. */
+static bool companion_identity(struct amdgpu_dm_connector *aconnector)
+{
+	return pair_eligible(aconnector) && published_sink(aconnector);
 }
 
 /* Resume: restoring the cached state leaves the connector without an active CRTC. */
@@ -268,6 +274,7 @@ bool dm_imac5k_keep_companion(struct amdgpu_dm_connector *aconnector, bool scale
 	struct amdgpu_display_manager *dm = &drm_to_adev(dev)->dm;
 	bool dark;
 
+	lockdep_assert_held(&aconnector->hpd_lock);
 	if (!companion_identity(aconnector))
 		return false;
 	dark = cached_dark(dm->cached_state, aconnector) &&
@@ -287,9 +294,31 @@ bool dm_imac5k_keep_companion(struct amdgpu_dm_connector *aconnector, bool scale
 }
 
 /*
- * hpd_lock held, before ordinary detection. While the pair is dark, the
- * companion's HPD only follows the primary's D3 write: hold the published
- * identity instead of detecting. Return true if the event is consumed.
+ * hpd_lock and dc_lock held. While the whole pair is dark, the companion's
+ * HPD only follows the primary's D3 write: hold a valid published identity
+ * instead of detecting.
+ */
+static bool hold_enter(struct amdgpu_dm_connector *aconnector)
+{
+	struct amdgpu_display_manager *dm = &drm_to_adev(aconnector->base.dev)->dm;
+	struct dm_imac5k_hold *h = &dm->imac5k_hold;
+	struct dc *dc = dm->dc;
+
+	if (dc_link_get_hpd_state(aconnector->dc_link) ||
+	    pair_stream(dc, dc->imac5k_pair.primary) ||
+	    pair_stream(dc, aconnector->dc_link) || !companion_identity(aconnector))
+		return false;
+	if (!h->held) {
+		h->held = true;
+		h->detections = 0;
+		drm_info(dm->ddev, "iMac 5K: holding companion identity while the pair is dark\n");
+	}
+	return true;
+}
+
+/*
+ * hpd_lock held, before ordinary detection. Return true if the hold
+ * consumes the event.
  */
 bool dm_imac5k_hold_hpd(struct amdgpu_dm_connector *aconnector)
 {
@@ -303,21 +332,31 @@ bool dm_imac5k_hold_hpd(struct amdgpu_dm_connector *aconnector)
 		return false;
 
 	guard(mutex)(&dm->dc_lock);
+	if (!h->held)
+		return hold_enter(aconnector);
 	hpd = dc_link_get_hpd_state(aconnector->dc_link);
 	lit = pair_stream(dc, dc->imac5k_pair.primary) != NULL;
-	if (h->held) {
-		/* With the primary lit, the wake check decides. */
-		h->held = lit || !hpd;
-		if (!h->held)
-			drm_info(dev, "iMac 5K: companion HPD rose while the primary is dark\n");
-		return h->held;
-	}
-	if (hpd || lit || pair_stream(dc, aconnector->dc_link) ||
-	    !companion_identity(aconnector))
+	/* With the primary lit, the wake check decides. */
+	h->held = lit || !hpd;
+	if (!h->held)
+		drm_info(dev, "iMac 5K: companion HPD rose while the primary is dark\n");
+	return h->held;
+}
+
+/*
+ * hpd_lock and dc_lock held, in the ordinary HPD body immediately before
+ * destructive detection. The pair may have gone dark since the caller
+ * decided to detect; hold it instead of publishing a disconnect.
+ */
+bool dm_imac5k_hold_dark_locked(struct amdgpu_dm_connector *aconnector)
+{
+	struct amdgpu_display_manager *dm = &drm_to_adev(aconnector->base.dev)->dm;
+
+	lockdep_assert_held(&aconnector->hpd_lock);
+	lockdep_assert_held(&dm->dc_lock);
+	if (aconnector->dc_link != dm->dc->imac5k_pair.companion || dm->imac5k_hold.closed)
 		return false;
-	h->held = true;
-	drm_info(dev, "iMac 5K: holding companion identity while the pair is dark\n");
-	return true;
+	return hold_enter(aconnector);
 }
 
 /* dc_lock held, before dc_commit_streams(): each wake gets its own check. */
@@ -339,10 +378,77 @@ void dm_imac5k_hold_commit(struct amdgpu_display_manager *dm,
 	}
 }
 
+struct hold_state {
+	bool hpd, identity, routed, active;
+};
+
+/*
+ * hpd_lock and dc_lock held. HPD is high and the valid published sink is
+ * either unrouted or carried by an active link.
+ */
+static bool hold_confirmed(struct amdgpu_dm_connector *aconnector, struct hold_state *s)
+{
+	struct dc_link *link = aconnector->dc_link;
+	struct dc_stream_state *stream = pair_stream(link->ctx->dc, link);
+
+	s->hpd = dc_link_get_hpd_state(link);
+	s->identity = companion_identity(aconnector);
+	s->routed = stream != NULL;
+	s->active = stream && stream->sink == aconnector->dc_sink &&
+		link->link_status.link_active;
+	return s->hpd && s->identity && (!s->routed || s->active);
+}
+
+/*
+ * hpd_lock held, after a fallback detection. Low HPD is a final, truthful
+ * disconnect. An eligible pair that is still not confirmed is checked
+ * again, up to IMAC5K_HOLD_DETECTIONS detections in all; after the last,
+ * the connector is reconciled with the link's sink so that what is
+ * published is coherent.
+ */
+static void hold_judge(struct amdgpu_display_manager *dm,
+		       struct amdgpu_dm_connector *aconnector)
+{
+	struct dm_imac5k_hold *h = &dm->imac5k_hold;
+	bool retry = false, reconcile = false;
+	struct hold_state s;
+
+	scoped_guard(mutex, &dm->dc_lock) {
+		/* The body held a new blank. */
+		if (h->closed || h->held)
+			return;
+		if (hold_confirmed(aconnector, &s) || !s.hpd || !pair_eligible(aconnector)) {
+			h->detections = 0;
+			return;
+		}
+		retry = ++h->detections < IMAC5K_HOLD_DETECTIONS;
+		if (retry) {
+			h->held = true;
+			mod_delayed_work(system_percpu_wq, &h->work,
+					 msecs_to_jiffies(IMAC5K_HOLD_CHECK_MS));
+		} else {
+			h->detections = 0;
+			reconcile = aconnector->dc_sink != aconnector->dc_link->local_sink;
+		}
+	}
+	if (retry) {
+		drm_info(dm->ddev, "iMac 5K: companion detection %u not confirmed; checking again\n",
+			 h->detections);
+		return;
+	}
+	drm_warn(dm->ddev, "iMac 5K: companion not recovered after %d detections; reconcile=%d\n",
+		 IMAC5K_HOLD_DETECTIONS, reconcile);
+	if (!reconcile)
+		return;
+	amdgpu_dm_update_connector_after_detect(aconnector);
+	drm_kms_helper_connector_hotplug_event(&aconnector->base);
+}
+
 /*
- * One check per wake. The companion's hpd_lock is held throughout, so no
- * HPD callback runs between the decision and a fallback detection. Only
- * the handler sets held, so the companion's connector exists.
+ * One check per wake, and bounded checks after a failed fallback. The
+ * companion's hpd_lock is held throughout, so no HPD callback runs between
+ * the decision, a fallback detection and its judgement. Only the mapped
+ * companion is ever held, so its connector exists.
  */
 static void hold_work(struct work_struct *work)
 {
@@ -351,9 +457,8 @@ static void hold_work(struct work_struct *work)
 	struct amdgpu_display_manager *dm =
 		container_of(h, struct amdgpu_display_manager, imac5k_hold);
 	struct amdgpu_dm_connector *aconnector = dm->dc->imac5k_pair.companion->priv;
-	struct dc_link *link = aconnector->dc_link;
-	struct dc_stream_state *stream;
-	bool hpd = false, identity = false, routed = false, active = false;
+	struct hold_state s;
+	bool confirmed;
 
 	guard(mutex)(&aconnector->hpd_lock);
 	scoped_guard(mutex, &dm->dc_lock) {
@@ -361,21 +466,20 @@ static void hold_work(struct work_struct *work)
 		if (h->closed || !h->held || !pair_stream(dm->dc, dm->dc->imac5k_pair.primary))
 			return;
 		h->held = false;
-		hpd = dc_link_get_hpd_state(link);
-		identity = companion_identity(aconnector);
-		stream = pair_stream(dm->dc, link);
-		routed = stream != NULL;
-		active = stream && stream->sink == aconnector->dc_sink &&
-			link->link_status.link_active;
+		confirmed = hold_confirmed(aconnector, &s);
+		if (confirmed)
+			h->detections = 0;
 	}
-	if (hpd && identity && (!routed || active)) {
-		drm_info(dm->ddev, "iMac 5K: companion hold released: routed=%d\n", routed);
+	if (confirmed) {
+		drm_info(dm->ddev, "iMac 5K: companion hold released: routed=%d\n", s.routed);
 		return;
 	}
 	drm_warn(dm->ddev, "iMac 5K: companion not confirmed after wake: hpd=%d identity=%d routed=%d active=%d; detecting\n",
-		 hpd, identity, routed, active);
-	if (!dm->disable_hpd_irq)
-		amdgpu_dm_hpd_detect_locked(aconnector, DETECT_REASON_HPD);
+		 s.hpd, s.identity, s.routed, s.active);
+	if (dm->disable_hpd_irq)
+		return;
+	amdgpu_dm_hpd_detect_locked(aconnector, DETECT_REASON_HPD);
+	hold_judge(dm, aconnector);
 }
 
 /* Writers take the companion's hpd_lock, then dc_lock. */
@@ -393,8 +497,10 @@ static void hold_admit(struct amdgpu_display_manager *dm, bool closed)
 	guard(mutex)(&dm->dc_lock);
 	dm->imac5k_hold.closed = closed;
 	/* Opening admits a hold armed by resume; closing drops it. */
-	if (closed)
+	if (closed) {
 		dm->imac5k_hold.held = false;
+		dm->imac5k_hold.detections = 0;
+	}
 }
 
 void dm_imac5k_hold_open(struct amdgpu_display_manager *dm)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.h
index 3cd75825cea25330141e3ffcba31defe0811b1ac..eb592cbeee9f17302ff983d0abbfea4b7d06f477 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_imac5k.h
@@ -22,15 +22,24 @@ struct dm_imac5k_recovery {
 };
 
 /*
- * The companion's published identity, held while the pair is dark. closed
- * and held are written under the companion's hpd_lock and then dc_lock;
- * either lock alone is enough to read them. Resume may set held while
- * closed; opening then admits it.
+ * The companion's published identity, held while the pair is dark. All
+ * fields but work are written under the companion's hpd_lock and then
+ * dc_lock; either lock alone is enough to read them.
+ *
+ *   closed  held
+ *   no      no    admitted: an HPD callback may enter the hold
+ *   no      yes   held: HPD changes are consumed; a wake queues the check
+ *   yes     no    closed for suspend, GPU reset or teardown
+ *   yes     yes   prepared by resume for a pair resuming dark; opening
+ *                 admits it
+ *
+ * detections counts fallback detections since the hold was entered.
  */
 struct dm_imac5k_hold {
 	struct delayed_work work;
 	bool closed;
 	bool held;
+	unsigned int detections;
 };
 
 void dm_imac5k_init(struct amdgpu_display_manager *dm);
@@ -40,6 +49,7 @@ void dm_imac5k_detected(struct amdgpu_dm_connector *aconnector, bool detected);
 void dm_imac5k_queue(struct amdgpu_display_manager *dm, int restore_error);
 bool dm_imac5k_keep_companion(struct amdgpu_dm_connector *aconnector, bool scaled);
 bool dm_imac5k_hold_hpd(struct amdgpu_dm_connector *aconnector);
+bool dm_imac5k_hold_dark_locked(struct amdgpu_dm_connector *aconnector);
 void dm_imac5k_hold_commit(struct amdgpu_display_manager *dm,
 			   const struct dc_commit_streams_params *params);
 void dm_imac5k_hold_open(struct amdgpu_display_manager *dm);
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
index b8247c990a8153cebe83d9bf9be290e5f91c8731..c09013872908db2a4df3feb8691d33ee150a5e84 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
@@ -1417,6 +1417,9 @@ void amdgpu_dm_hpd_detect_locked(struct amdgpu_dm_connector *aconnector,
 			return;
 
 		scoped_guard(mutex, &adev->dm.dc_lock) {
+			/* An iMac pair that went dark since the caller decided. */
+			if (dm_imac5k_hold_dark_locked(aconnector))
+				return;
 			dc_exit_ips_for_hw_access(dc);
 			ret = dc_link_detect(aconnector->dc_link, reason);
 		}
