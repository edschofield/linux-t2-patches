From a318ad74180713bb567886dd7bf6df927b532d6f Mon Sep 17 00:00:00 2001
From: Ed Schofield <ed@aicharmers.com>
Date: Wed, 21 Oct 2026 13:03:03 +1100
Subject: [PATCH] drm/amd/display: Re-arm the iMac 5K right tile after every
 left-tile D0

On iMac20,1 every DP_SET_POWER=D3 write to the left tile's eDP receiver
clears its DPCD register 0x4F1 (36 of 36 traced writes, across boot,
DPMS and S3). The right tile's receiver, HPD and AUX respond only while
that register is 1.

The existing write in the commit tail runs after dc_commit_streams()
returns, which is too late for the right tile's training in the same
commit. Write it again whenever the left tile's receiver is powered up,
so the right tile can train as soon as the left tile is up.
---
 drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_phy.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_phy.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_phy.c
index 49521ac4b..d4615b01d 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_phy.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_phy.c
@@ -53,6 +53,12 @@ void dpcd_write_rx_power_ctrl(struct dc_link *link, bool on)
 	core_link_write_dpcd(link, DP_SET_POWER, &state,
 						 sizeof(state));
 
+	/* iMac 5K: D3 clears 0x4F1, which enables the right tile's receiver. */
+	if (on && link->dc->config.imac5K_support &&
+	    link->connector_signal == SIGNAL_TYPE_EDP) {
+		state = 1;
+		core_link_write_dpcd(link, 0x4F1, &state, sizeof(state));
+	}
 }
 
 void dp_enable_link_phy(
