From dda27038a126918b1109cc433c5a48f4cda38d0c Mon Sep 17 00:00:00 2001
From: Atharva Tiwari <atharvatiwarilinuxdev@gmail.com>
Date: Wed, 28 Oct 2026 16:44:37 +1100
Subject: [PATCH] drm/amdgpu: Add support for the iMac 5K panel

The internal 5120x2880 panel of the iMac20,1 and iMac20,2 is driven as
two 2560x2880 tiles: the left by eDP on link 0 and the right by DP on
link 1. Each tile has its own connector, grouped by the TILE property.
The right tile's receiver, HPD and AUX respond only while the left
tile's receiver is powered and its Apple-specific, undocumented DPCD
register 0x4F1 is 1, so without a write to it the right tile is never
detected. Every DP_SET_POWER D3 write to the left tile clears the
register (36 of 36 traced writes across boot, DPMS and S3).

Match both models by DMI and, on them only:

- Add the display IP blocks before the SMU. Without this, SMU
  initialisation timed out on 13 of 20 warm boots of an iMac20,1; an
  iMac20,2 failed 9 of 20 without it and 0 of 100 with it. Why the order
  matters is not known.

- Set 0x4F1 when the left tile is detected, and again after every D0
  write to its receiver, so that the right tile can be detected and
  trained. At boot the right tile's HPD rises 73-83 ms after this write.

- Before the right tile's boot detection and before training it, wait
  up to 150 ms for its HPD and a successful DPCD read. Boot detection
  otherwise reaches it before its HPD rises, while HPD interrupts are
  still disabled. It was then found seconds later, after fbcon had sized
  the console for the left tile alone and pruned both tiles' native
  modes. If the receiver is still not ready, boot detection leaves the
  tile for a later HPD edge, and training goes ahead as before.

- Enable the left tile's master pipe before the right tile's. With the
  right tile's CRTC on the lower pipe, its training failed on AUX; it
  trained once the left tile was up.

- Keep the right tile's sink once its EDID includes the extension block
  with the tile data, as DC does for eDP, and have link_detect() return
  early for it. Its HPD follows the left tile's power state, not a
  cable, so otherwise DPMS publishes DP-1 as disconnected, S3 resume
  misses the HPD rise, and resume in a scaled mode reads a 640x480 EDID
  while 0x4F1 is clear. Forcing the connector off, or on while the panel
  is dark, clears its published EDID; restore it from the kept sink when
  modes are next probed. Writing 0 to the connector's debugfs
  trigger_hotplug still releases the sink.

- After training the right tile, ignore its lane status during the idle
  pattern, but still treat a failed read as link loss. The idle check
  reported lane loss in 103 of 189 attempts on lanes that were aligned
  once video flowed. skip_fallback_on_link_loss is not used because it
  also relaxes the equalisation check and live link-loss handling.

- When the left tile's link is (re)enabled, clear the right tile's
  link_state_valid so that its unchanged stream restarts after the left.
  A "max bpc" or "Colorspace" change on the left tile alone, or blanking
  only the left CRTC, otherwise restarted the left link and lost the
  right tile's link with nothing to retrain it.

- Do not attach "max bpc" to either tile. With the left stream at 8 bpc
  and the right at 10 bpc, the right half of the panel lost its image
  although both links stayed trained; at 8/8 and 10/10 bpc both halves
  show. Both tiles then take their depth from the EDID.

- When a non-native mode on the left tile falls back to scaling, use
  RMX_FULL instead of RMX_ASPECT. A scaled mode drives the whole panel
  through the left tile's 2560x2880 timing, which RMX_ASPECT would
  letterbox.

Only the iMac20,1 has been tested with these changes. The GPU-reset path
is untested: a GPU reset hangs this iMac without this patch too.

Co-developed-by: Ed Schofield <ed@aicharmers.com>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c |  37 +++-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |   2 +
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |   9 +
 .../display/amdgpu_dm/amdgpu_dm_connector.c   |  23 ++-
 .../amd/display/amdgpu_dm/amdgpu_dm_quirks.c  |  29 +++-
 .../tests/amdgpu_dm_connector_test.c          | 162 +++++++++++++++++-
 drivers/gpu/drm/amd/display/dc/dc.h           |  29 ++++
 .../amd/display/dc/hwss/dce110/dce110_hwseq.c |  44 ++++-
 .../drm/amd/display/dc/link/link_detection.c  |  22 +++
 .../gpu/drm/amd/display/dc/link/link_dpms.c   |  30 ++++
 .../gpu/drm/amd/display/dc/link/link_dpms.h   |   1 +
 .../display/dc/link/protocols/link_dp_phy.c   |   7 +
 .../dc/link/protocols/link_dp_training.c      |  10 +-
 13 files changed, 393 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
index 16e3129db..fabe37fc7 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
@@ -21,6 +21,7 @@
  *
  */
 
+#include <linux/dmi.h>
 #include <linux/firmware.h>
 #include <linux/kernfs.h>
 
@@ -3413,8 +3414,25 @@ static int amdgpu_discovery_set_ualink_ip_blocks(struct amdgpu_device *adev)
 	return 0;
 }
 
+static const struct dmi_system_id amdgpu_discovery_imac5k_table[] = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,1"),
+		},
+	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,2"),
+		},
+	},
+	{}
+};
+
 int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 {
+	bool display_first;
 	int r;
 
 	switch (adev->asic_type) {
@@ -4030,15 +4048,28 @@ int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 		}
 	}
 
+	/*
+	 * iMac 5K: SMU initialisation times out on some warm boots unless
+	 * the display blocks are added before the SMU. The cause is unknown.
+	 */
+	display_first = dmi_check_system(amdgpu_discovery_imac5k_table);
+	if (display_first) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
+
 	if (likely(adev->firmware.load_type == AMDGPU_FW_LOAD_PSP)) {
 		r = amdgpu_discovery_set_smu_ip_blocks(adev);
 		if (r)
 			return r;
 	}
 
-	r = amdgpu_discovery_set_display_ip_blocks(adev);
-	if (r)
-		return r;
+	if (!display_first) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
 
 	r = amdgpu_discovery_set_gc_ip_blocks(adev);
 	if (r)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index dfbc384fb..ab957bf96 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -641,6 +641,8 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 	retrieve_dmi_info(&adev->dm);
 	if (adev->dm.edp0_on_dp1_quirk)
 		init_data.flags.support_edp0_on_dp1 = true;
+	if (adev->dm.imac5k_support)
+		init_data.flags.imac5k_support = true;
 
 	if (adev->dm.bb_from_dmub)
 		init_data.bb_from_dmub = adev->dm.bb_from_dmub;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 656aa0e46..9aa3169d5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -698,6 +698,15 @@ struct amdgpu_display_manager {
 	 */
 	bool edp0_on_dp1_quirk;
 
+	/**
+	 * @imac5k_support:
+	 *
+	 * Quirk for the iMac 5K (iMac20,1 and iMac20,2), whose internal panel
+	 * is driven as two tiles: the left by eDP on link 0, the right by DP
+	 * on link 1.
+	 */
+	bool imac5k_support;
+
 	/**
 	 * @dpia_aux_lock:
 	 *
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index bc5745a5b..6b01fc14b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -123,7 +123,10 @@ STATIC_IFN_KUNIT int dm_encoder_helper_atomic_check(struct drm_encoder *encoder,
 				       "mode %dx%d@%dHz is not native, enabling scaling\n",
 				       adjusted_mode->hdisplay, adjusted_mode->vdisplay,
 				       drm_mode_vrefresh(adjusted_mode));
-			dm_new_connector_state->scaling = RMX_ASPECT;
+			/* iMac 5K: fill the panel rather than letterbox in the tile. */
+			dm_new_connector_state->scaling =
+				aconnector->dc_link->dc->config.imac5k_support ?
+				RMX_FULL : RMX_ASPECT;
 		}
 		return 0;
 	}
@@ -3096,9 +3099,24 @@ STATIC_IFN_KUNIT int amdgpu_dm_connector_get_modes(struct drm_connector *connect
 	const struct drm_edid *drm_edid = amdgpu_dm_connector->drm_edid;
 	struct dc_link_settings *verified_link_cap = &dc_link->verified_link_cap;
 	const struct dc *dc = dc_link->dc;
+	struct dc_sink *sink = amdgpu_dm_connector->dc_sink;
 
 	encoder = amdgpu_dm_connector_to_encoder(connector);
 
+	/*
+	 * iMac 5K: forcing the right tile's connector off, or on while the
+	 * panel is dark, clears its published EDID. No detection publishes a
+	 * kept sink again, so restore the EDID from the sink.
+	 */
+	if (dc_link_is_imac5k_right_tile(dc_link) && sink &&
+	    dc_sink_is_kept_imac5k_tile(sink) && !connector->edid_blob_ptr) {
+		const struct drm_edid *kept = drm_edid_alloc(sink->dc_edid.raw_edid,
+							     sink->dc_edid.length);
+
+		drm_edid_connector_update(connector, kept);
+		drm_edid_free(kept);
+	}
+
 	if (!drm_edid) {
 		amdgpu_dm_connector->num_modes =
 				drm_add_modes_noedid(connector, 640, 480);
@@ -3272,7 +3290,8 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 				adev->mode_info.underscan_vborder_property,
 				0);
 
-	if (!aconnector->mst_root)
+	/* iMac 5K: unequal tile depths lose the right tile's image; no per-tile cap. */
+	if (!aconnector->mst_root && !(dm->imac5k_support && link_index <= 1))
 		drm_connector_attach_max_bpc_property(&aconnector->base, 8, 16);
 
 	aconnector->base.state->max_bpc = 16;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_quirks.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_quirks.c
index 259966703..d0b2562c8 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_quirks.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_quirks.c
@@ -33,11 +33,13 @@
 struct amdgpu_dm_quirks {
 	bool aux_hpd_discon;
 	bool support_edp0_on_dp1;
+	bool imac5k_support;
 };
 
 static struct amdgpu_dm_quirks quirk_entries = {
 	.aux_hpd_discon = false,
-	.support_edp0_on_dp1 = false
+	.support_edp0_on_dp1 = false,
+	.imac5k_support = false,
 };
 
 static int edp0_on_dp1_callback(const struct dmi_system_id *id)
@@ -52,6 +54,12 @@ static int aux_hpd_discon_callback(const struct dmi_system_id *id)
 	return 0;
 }
 
+static int imac5k_support_callback(const struct dmi_system_id *id)
+{
+	quirk_entries.imac5k_support = true;
+	return 0;
+}
+
 static const struct dmi_system_id dmi_quirk_table[] = {
 	{
 		.callback = aux_hpd_discon_callback,
@@ -151,6 +159,20 @@ static const struct dmi_system_id dmi_quirk_table[] = {
 			DMI_MATCH(DMI_PRODUCT_NAME, "HP ProBook 465 16 inch G11 Notebook PC"),
 		},
 	},
+	{
+		.callback = imac5k_support_callback,
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,1"),
+		},
+	},
+	{
+		.callback = imac5k_support_callback,
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,2"),
+		},
+	},
 	{}
 	/* TODO: refactor this from a fixed table to a dynamic option */
 };
@@ -162,6 +184,7 @@ void retrieve_dmi_info(struct amdgpu_display_manager *dm)
 
 	dm->aux_hpd_discon_quirk = false;
 	dm->edp0_on_dp1_quirk = false;
+	dm->imac5k_support = false;
 
 	dmi_id = dmi_check_system(dmi_quirk_table);
 
@@ -176,6 +199,10 @@ void retrieve_dmi_info(struct amdgpu_display_manager *dm)
 		dm->edp0_on_dp1_quirk = true;
 		drm_info(dev, "support_edp0_on_dp1 attached\n");
 	}
+	if (quirk_entries.imac5k_support) {
+		dm->imac5k_support = true;
+		drm_info(dev, "imac5k_support attached\n");
+	}
 }
 EXPORT_IF_KUNIT(retrieve_dmi_info);
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
index acde20241..3b55094f3 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -5155,7 +5155,8 @@ static void dm_test_encoder_disable_noop(struct kunit *test)
  * dm_encoder_helper_atomic_check() reads back through to_amdgpu_encoder(),
  * to_amdgpu_dm_connector() and to_dm_connector_state(), so the encoder,
  * connector and connector-state are stacked in their containers and wired
- * together through conn_state->connector.
+ * together through conn_state->connector. The connector has a dc_link whose
+ * dc has every config flag clear, as on a board without quirks.
  */
 /* Tests for amdgpu_dm_encoder_init() */
 
@@ -5200,6 +5201,7 @@ struct dm_test_atomic_check_ctx {
 	struct amdgpu_dm_connector *aconnector;
 	struct dm_connector_state *dm_state;
 	struct drm_crtc_state *crtc_state;
+	struct dc *dc;
 };
 
 static struct dm_test_atomic_check_ctx *
@@ -5220,6 +5222,13 @@ dm_test_atomic_check_ctx_alloc(struct kunit *test, int connector_type)
 	KUNIT_ASSERT_NOT_NULL(test, ctx->aconnector);
 	ctx->aconnector->base.connector_type = connector_type;
 
+	ctx->dc = kunit_kzalloc(test, sizeof(*ctx->dc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->dc);
+	ctx->aconnector->dc_link = kunit_kzalloc(test, sizeof(*ctx->aconnector->dc_link),
+						 GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->aconnector->dc_link);
+	ctx->aconnector->dc_link->dc = ctx->dc;
+
 	ctx->dm_state = kunit_kzalloc(test, sizeof(*ctx->dm_state), GFP_KERNEL);
 	KUNIT_ASSERT_NOT_NULL(test, ctx->dm_state);
 	ctx->dm_state->base.connector = &ctx->aconnector->base;
@@ -5280,6 +5289,59 @@ static void dm_test_atomic_check_lvds_non_native_enables_scaling(struct kunit *t
 	KUNIT_EXPECT_EQ(test, (int)ctx->dm_state->scaling, (int)RMX_ASPECT);
 }
 
+/**
+ * dm_test_atomic_check_imac5k_non_native_fills_panel - Test iMac 5K scaled modes fill the panel
+ * @test: The KUnit test context
+ *
+ * On the iMac 5K, a non-native mode on the left tile's eDP drives the whole
+ * panel from one 2560x2880 tile timing, so the fallback selects RMX_FULL
+ * rather than letterboxing with RMX_ASPECT.
+ */
+static void dm_test_atomic_check_imac5k_non_native_fills_panel(struct kunit *test)
+{
+	struct dm_test_atomic_check_ctx *ctx =
+		dm_test_atomic_check_ctx_alloc(test, DRM_MODE_CONNECTOR_eDP);
+
+	ctx->dc->config.imac5k_support = true;
+	ctx->aenc->native_mode.hdisplay = 2560;
+	ctx->aenc->native_mode.vdisplay = 2880;
+	ctx->crtc_state->adjusted_mode.hdisplay = 2560;
+	ctx->crtc_state->adjusted_mode.vdisplay = 1440;
+	ctx->dm_state->scaling = RMX_OFF;
+
+	KUNIT_EXPECT_EQ(test,
+		dm_encoder_helper_atomic_check(&ctx->aenc->base,
+					       ctx->crtc_state,
+					       &ctx->dm_state->base), 0);
+	KUNIT_EXPECT_EQ(test, (int)ctx->dm_state->scaling, (int)RMX_FULL);
+}
+
+/**
+ * dm_test_atomic_check_imac5k_keeps_user_scaling - Test iMac 5K respects a chosen scaling mode
+ * @test: The KUnit test context
+ *
+ * The iMac 5K fallback applies only while the scaling property is RMX_OFF;
+ * a scaling mode chosen by userspace is left unchanged.
+ */
+static void dm_test_atomic_check_imac5k_keeps_user_scaling(struct kunit *test)
+{
+	struct dm_test_atomic_check_ctx *ctx =
+		dm_test_atomic_check_ctx_alloc(test, DRM_MODE_CONNECTOR_eDP);
+
+	ctx->dc->config.imac5k_support = true;
+	ctx->aenc->native_mode.hdisplay = 2560;
+	ctx->aenc->native_mode.vdisplay = 2880;
+	ctx->crtc_state->adjusted_mode.hdisplay = 2560;
+	ctx->crtc_state->adjusted_mode.vdisplay = 1440;
+	ctx->dm_state->scaling = RMX_CENTER;
+
+	KUNIT_EXPECT_EQ(test,
+		dm_encoder_helper_atomic_check(&ctx->aenc->base,
+					       ctx->crtc_state,
+					       &ctx->dm_state->base), 0);
+	KUNIT_EXPECT_EQ(test, (int)ctx->dm_state->scaling, (int)RMX_CENTER);
+}
+
 /**
  * dm_test_atomic_check_non_mst_returns_zero - Test non-MST connectors short-circuit
  * @test: The KUnit test context
@@ -5546,6 +5608,96 @@ static void dm_test_atomic_check_mst_vcpi_error_propagates(struct kunit *test)
 					       &ctx->dm_state->base), -EINVAL);
 }
 
+/* Tests for dc_sink_is_kept_imac5k_tile() */
+
+/*
+ * Build a DP sink on link 1 with an EDID that includes an extension block:
+ * the right tile's sink once fully read when @imac5k_support is set.
+ */
+static struct dc_sink *dm_test_imac5k_sink_alloc(struct kunit *test, bool imac5k_support)
+{
+	struct dc_sink *sink;
+	struct dc_link *link;
+	struct dc *dc;
+
+	dc = kunit_kzalloc(test, sizeof(*dc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dc);
+	link = kunit_kzalloc(test, sizeof(*link), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, link);
+	sink = kunit_kzalloc(test, sizeof(*sink), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sink);
+
+	dc->config.imac5k_support = imac5k_support;
+	link->dc = dc;
+	link->link_index = 1;
+	sink->link = link;
+	sink->sink_signal = SIGNAL_TYPE_DISPLAY_PORT;
+	sink->dc_edid.length = 2 * DC_EDID_BLOCK_SIZE;
+
+	return sink;
+}
+
+/**
+ * dm_test_imac5k_kept_tile_right - Test the right tile's full sink is kept
+ * @test: The KUnit test context
+ */
+static void dm_test_imac5k_kept_tile_right(struct kunit *test)
+{
+	struct dc_sink *sink = dm_test_imac5k_sink_alloc(test, true);
+
+	KUNIT_EXPECT_TRUE(test, dc_sink_is_kept_imac5k_tile(sink));
+}
+
+/**
+ * dm_test_imac5k_kept_tile_base_block_only - Test a sink without the tile extension is not kept
+ * @test: The KUnit test context
+ *
+ * A failed or partial EDID read leaves only the base block, so the next
+ * detection must read the EDID again.
+ */
+static void dm_test_imac5k_kept_tile_base_block_only(struct kunit *test)
+{
+	struct dc_sink *sink = dm_test_imac5k_sink_alloc(test, true);
+
+	sink->dc_edid.length = DC_EDID_BLOCK_SIZE;
+	KUNIT_EXPECT_FALSE(test, dc_sink_is_kept_imac5k_tile(sink));
+}
+
+/**
+ * dm_test_imac5k_kept_tile_other_link - Test sinks on other links are not kept
+ * @test: The KUnit test context
+ */
+static void dm_test_imac5k_kept_tile_other_link(struct kunit *test)
+{
+	struct dc_sink *sink = dm_test_imac5k_sink_alloc(test, true);
+
+	sink->link->link_index = 2;
+	KUNIT_EXPECT_FALSE(test, dc_sink_is_kept_imac5k_tile(sink));
+}
+
+/**
+ * dm_test_imac5k_kept_tile_virtual_sink - Test a non-DP sink on link 1 is not kept
+ * @test: The KUnit test context
+ */
+static void dm_test_imac5k_kept_tile_virtual_sink(struct kunit *test)
+{
+	struct dc_sink *sink = dm_test_imac5k_sink_alloc(test, true);
+
+	sink->sink_signal = SIGNAL_TYPE_VIRTUAL;
+	KUNIT_EXPECT_FALSE(test, dc_sink_is_kept_imac5k_tile(sink));
+}
+
+/**
+ * dm_test_imac5k_kept_tile_no_quirk - Test no sink is kept without the quirk
+ * @test: The KUnit test context
+ */
+static void dm_test_imac5k_kept_tile_no_quirk(struct kunit *test)
+{
+	struct dc_sink *sink = dm_test_imac5k_sink_alloc(test, false);
+
+	KUNIT_EXPECT_FALSE(test, dc_sink_is_kept_imac5k_tile(sink));
+}
+
 /* Tests for hdmi_cec_unset_edid() */
 
 /**
@@ -10277,6 +10429,8 @@ static struct kunit_case amdgpu_dm_connector_tests[] = {
 	/* dm_encoder_helper_atomic_check */
 	KUNIT_CASE(dm_test_atomic_check_edp_native_keeps_scaling),
