+/*
+ * iMac 5K: wait up to 150 ms for the right tile's HPD and a successful DPCD
+ * read. Returns false if the right tile's receiver is still not ready.
+ */
+bool link_wait_for_imac5k_right_tile(struct dc_link *link)
+{
+	unsigned long long start = dm_get_timestamp(link->ctx);
+	uint8_t rev;
+
+	while (!link_get_hpd_state(link) ||
+	       core_link_read_dpcd(link, DP_DPCD_REV, &rev, 1) != DC_OK) {
+		if (dm_get_elapse_time_in_ns(link->ctx, dm_get_timestamp(link->ctx),
+					     start) > 150 * NSEC_PER_MSEC)
+			return false;
+		fsleep(1000);
+	}
+	return true;
+}
